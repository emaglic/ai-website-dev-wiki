# Mutable user design inputs (keep only the template directory placeholders)
/input/*
!/input/assets/
!/input/mockups/
/input/assets/*
!/input/assets/.gitkeep
/input/mockups/*
!/input/mockups/.gitkeep

# Ephemeral deliverables requested for human consumption
/output/*
!/output/.gitkeep

# Ephemeral user handoffs
/temp/*
!/temp/.gitkeep

# Agent-generated review and working artifacts
/wiki/temp/*
!/wiki/temp/.gitkeep

# Repo-local agent coordination
.agents/locks/*
!.agents/locks/.gitkeep

# Secrets and local environment files
.env
.env.*
!.env.example

# Dependency directories
node_modules/
vendor/

# Package manager and tool caches
.cache/
.parcel-cache/
.turbo/
.vite/
.next/
.nuxt/
.svelte-kit/

# Build and test outputs
dist/
build/
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and editor metadata
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
